{
  "apiVersion": 1,
  "contactPoints": [
    {
      "orgId": 1,
      "name": "Secret Santa Telegram",
      "receivers": [
        {
          "uid": "secret_santa_telegram",
          "type": "telegram",
          "disableResolveMessage": false,
          "settings": {
            "bottoken": "$TELEGRAM_BOT_TOKEN",
            "chatid": "249108527",
            "message": "{{ template \"default.message\" . }}"
          }
        }
      ]
    }
  ],
  "groups": [
    {
      "orgId": 1,
      "name": "secret-santa",
      "folder": "Infra",
      "interval": "1m",
      "rules": [
        {
          "uid": "ssErrorLogs",
          "title": "Secret Santa: рост ошибок в логах",
          "condition": "B",
          "data": [
            {
              "refId": "A",
              "queryType": "instant",
              "relativeTimeRange": {
                "from": 3600,
                "to": 0
              },
              "datasourceUid": "P8E80F9AEF21F6940",
              "model": {
                "datasource": {
                  "type": "loki",
                  "uid": "P8E80F9AEF21F6940"
                },
                "editorMode": "code",
                "expr": "sum(count_over_time({container=~\"/?secret-santa-(api|worker)-1\"} | json | level=\"error\" [10m]))",
                "instant": true,
                "intervalMs": 1000,
                "maxDataPoints": 43200,
                "range": false,
                "refId": "A",
                "queryType": "instant"
              }
            },
            {
              "refId": "B",
              "queryType": "",
              "relativeTimeRange": {
                "from": 0,
                "to": 0
              },
              "datasourceUid": "__expr__",
              "model": {
                "conditions": [
                  {
                    "evaluator": {
                      "params": [
                        5
                      ],
                      "type": "gt"
                    },
                    "operator": {
                      "type": "and"
                    },
                    "query": {
                      "params": [
                        "B"
                      ]
                    },
                    "reducer": {
                      "params": [],
                      "type": "last"
                    },
                    "type": "query"
                  }
                ],
                "datasource": {
                  "type": "__expr__",
                  "uid": "__expr__"
                },
                "expression": "A",
                "intervalMs": 1000,
                "maxDataPoints": 43200,
                "refId": "B",
                "type": "threshold"
              }
            }
          ],
          "noDataState": "OK",
          "execErrState": "Error",
          "for": "0s",
          "annotations": {
            "summary": "Больше 5 ошибок в логах api/worker за 10 минут",
            "description": "Логи с level=error в Loki: смотрите Explore по контейнерам secret-santa-api-1 и secret-santa-worker-1."
          },
          "labels": {
            "service": "secret-santa",
            "severity": "warning"
          },
          "notification_settings": {
            "receiver": "Secret Santa Telegram"
          }
        },
        {
          "uid": "ssOutboxAge",
          "title": "Secret Santa: outbox застрял",
          "condition": "B",
          "data": [
            {
              "refId": "A",
              "queryType": "",
              "relativeTimeRange": {
                "from": 3600,
                "to": 0
              },
              "datasourceUid": "PBFA97CFB590B2093",
              "model": {
                "datasource": {
                  "type": "prometheus",
                  "uid": "PBFA97CFB590B2093"
                },
                "editorMode": "code",
                "expr": "max(santa_outbox_oldest_due_age_seconds{job=\"secret_santa_worker\"})",
                "instant": true,
                "intervalMs": 1000,
                "maxDataPoints": 43200,
                "range": false,
                "refId": "A"
              }
            },
            {
              "refId": "B",
              "queryType": "",
              "relativeTimeRange": {
                "from": 0,
                "to": 0
              },
              "datasourceUid": "__expr__",
              "model": {
                "conditions": [
                  {
                    "evaluator": {
                      "params": [
                        300
                      ],
                      "type": "gt"
                    },
                    "operator": {
                      "type": "and"
                    },
                    "query": {
                      "params": [
                        "B"
                      ]
                    },
                    "reducer": {
                      "params": [],
                      "type": "last"
                    },
                    "type": "query"
                  }
                ],
                "datasource": {
                  "type": "__expr__",
                  "uid": "__expr__"
                },
                "expression": "A",
                "intervalMs": 1000,
                "maxDataPoints": 43200,
                "refId": "B",
                "type": "threshold"
              }
            }
          ],
          "noDataState": "OK",
          "execErrState": "Error",
          "for": "5m",
          "annotations": {
            "summary": "Самая ранняя отправка outbox просрочена больше чем на 5 минут",
            "description": "Worker не успевает или не шлёт: проверьте его логи, 429 от Telegram и доступность БД."
          },
          "labels": {
            "service": "secret-santa",
            "severity": "warning"
          },
          "notification_settings": {
            "receiver": "Secret Santa Telegram"
          }
        },
        {
          "uid": "ss429Spike",
          "title": "Secret Santa: всплеск 429 от Telegram",
          "condition": "B",
          "data": [
            {
              "refId": "A",
              "queryType": "",
              "relativeTimeRange": {
                "from": 3600,
                "to": 0
              },
              "datasourceUid": "PBFA97CFB590B2093",
              "model": {
                "datasource": {
                  "type": "prometheus",
                  "uid": "PBFA97CFB590B2093"
                },
                "editorMode": "code",
                "expr": "sum(increase(santa_outbox_send_errors_total{job=\"secret_santa_worker\",code=\"429\"}[10m]))",
                "instant": true,
                "intervalMs": 1000,
                "maxDataPoints": 43200,
                "range": false,
                "refId": "A"
              }
            },
            {
              "refId": "B",
              "queryType": "",
              "relativeTimeRange": {
                "from": 0,
                "to": 0
              },
              "datasourceUid": "__expr__",
              "model": {
                "conditions": [
                  {
                    "evaluator": {
                      "params": [
                        20
                      ],
                      "type": "gt"
                    },
                    "operator": {
                      "type": "and"
                    },
                    "query": {
                      "params": [
                        "B"
                      ]
                    },
                    "reducer": {
                      "params": [],
                      "type": "last"
                    },
                    "type": "query"
                  }
                ],
                "datasource": {
                  "type": "__expr__",
                  "uid": "__expr__"
                },
                "expression": "A",
                "intervalMs": 1000,
                "maxDataPoints": 43200,
                "refId": "B",
                "type": "threshold"
              }
            }
          ],
          "noDataState": "OK",
          "execErrState": "Error",
          "for": "0s",
          "annotations": {
            "summary": "Больше 20 ответов 429 от Bot API за 10 минут",
            "description": "Флуд-контроль Telegram: лимитер outbox слишком агрессивен или идёт массовая рассылка."
          },
          "labels": {
            "service": "secret-santa",
            "severity": "warning"
          },
          "notification_settings": {
            "receiver": "Secret Santa Telegram"
          }
        },
        {
          "uid": "ssDown",
          "title": "Secret Santa: сервис не отвечает",
          "condition": "B",
          "data": [
            {
              "refId": "A",
              "queryType": "",
              "relativeTimeRange": {
                "from": 3600,
                "to": 0
              },
              "datasourceUid": "PBFA97CFB590B2093",
              "model": {
                "datasource": {
                  "type": "prometheus",
                  "uid": "PBFA97CFB590B2093"
                },
                "editorMode": "code",
                "expr": "min(up{job=~\"secret_santa|secret_santa_worker\"})",
                "instant": true,
                "intervalMs": 1000,
                "maxDataPoints": 43200,
                "range": false,
                "refId": "A"
              }
            },
            {
              "refId": "B",
              "queryType": "",
              "relativeTimeRange": {
                "from": 0,
                "to": 0
              },
              "datasourceUid": "__expr__",
              "model": {
                "conditions": [
                  {
                    "evaluator": {
                      "params": [
                        1
                      ],
                      "type": "lt"
                    },
                    "operator": {
                      "type": "and"
                    },
                    "query": {
                      "params": [
                        "B"
                      ]
                    },
                    "reducer": {
                      "params": [],
                      "type": "last"
                    },
                    "type": "query"
                  }
                ],
                "datasource": {
                  "type": "__expr__",
                  "uid": "__expr__"
                },
                "expression": "A",
                "intervalMs": 1000,
                "maxDataPoints": 43200,
                "refId": "B",
                "type": "threshold"
              }
            }
          ],
          "noDataState": "Alerting",
          "execErrState": "Error",
          "for": "2m",
          "annotations": {
            "summary": "Prometheus не достаёт /metrics api или worker'а",
            "description": "Контейнер упал, перезапускается или выпал из monitoring_net."
          },
          "labels": {
            "service": "secret-santa",
            "severity": "critical"
          },
          "notification_settings": {
            "receiver": "Secret Santa Telegram"
          }
        },
        {
          "uid": "ssCidrDrift",
          "title": "Secret Santa: адреса Telegram изменились",
          "condition": "B",
          "data": [
            {
              "refId": "A",
              "queryType": "",
              "relativeTimeRange": {
                "from": 3600,
                "to": 0
              },
              "datasourceUid": "PBFA97CFB590B2093",
              "model": {
                "datasource": {
                  "type": "prometheus",
                  "uid": "PBFA97CFB590B2093"
                },
                "editorMode": "code",
                "expr": "max(santa_telegram_cidr_drift{job=\"secret_santa_worker\"})",
                "instant": true,
                "intervalMs": 1000,
                "maxDataPoints": 43200,
                "range": false,
                "refId": "A"
              }
            },
            {
              "refId": "B",
              "queryType": "",
              "relativeTimeRange": {
                "from": 0,
                "to": 0
              },
              "datasourceUid": "__expr__",
              "model": {
                "conditions": [
                  {
                    "evaluator": {
                      "params": [
                        0
                      ],
                      "type": "gt"
                    },
                    "operator": {
                      "type": "and"
                    },
                    "query": {
                      "params": [
                        "B"
                      ]
                    },
                    "reducer": {
                      "params": [],
                      "type": "last"
                    },
                    "type": "query"
                  }
                ],
                "datasource": {
                  "type": "__expr__",
                  "uid": "__expr__"
                },
                "expression": "A",
                "intervalMs": 1000,
                "maxDataPoints": 43200,
                "refId": "B",
                "type": "threshold"
              }
            }
          ],
          "noDataState": "OK",
          "execErrState": "Error",
          "for": "0s",
          "annotations": {
            "summary": "cidr.txt Telegram расходится с копией в коде (D34)",
            "description": "В логе worker'а — добавленные и убранные диапазоны (added/removed). Обновите WAF-правило Cloudflare «Telegram webhooks: only Telegram IPs» на /tg/* и TELEGRAM_CIDRS в backend/app/modules/bots/domain.py вместе."
          },
          "labels": {
            "service": "secret-santa",
            "severity": "warning"
          },
          "notification_settings": {
            "receiver": "Secret Santa Telegram"
          }
        },
        {
          "uid": "ssWebhookErrors",
          "title": "Secret Santa: Telegram не доставляет вебхуки",
          "condition": "B",
          "data": [
            {
              "refId": "A",
              "queryType": "",
              "relativeTimeRange": {
                "from": 3600,
                "to": 0
              },
              "datasourceUid": "PBFA97CFB590B2093",
              "model": {
                "datasource": {
                  "type": "prometheus",
                  "uid": "PBFA97CFB590B2093"
                },
                "editorMode": "code",
                "expr": "max by (bot_id) (santa_webhook_delivery_error{job=\"secret_santa_worker\"})",
                "instant": true,
                "intervalMs": 1000,
                "maxDataPoints": 43200,
                "range": false,
                "refId": "A"
              }
            },
            {
              "refId": "B",
              "queryType": "",
              "relativeTimeRange": {
                "from": 0,
                "to": 0
              },
              "datasourceUid": "__expr__",
              "model": {
                "conditions": [
                  {
                    "evaluator": {
                      "params": [
                        0
                      ],
                      "type": "gt"
                    },
                    "operator": {
                      "type": "and"
                    },
                    "query": {
                      "params": [
                        "B"
                      ]
                    },
                    "reducer": {
                      "params": [],
                      "type": "last"
                    },
                    "type": "query"
                  }
                ],
                "datasource": {
                  "type": "__expr__",
                  "uid": "__expr__"
                },
                "expression": "A",
                "intervalMs": 1000,
                "maxDataPoints": 43200,
                "refId": "B",
                "type": "threshold"
              }
            }
          ],
          "noDataState": "OK",
          "execErrState": "Error",
          "for": "0s",
          "annotations": {
            "summary": "getWebhookInfo бота {{ $labels.bot_id }} сообщает свежую ошибку доставки",
            "description": "Текст ошибки — в логе worker'а (last_error_message). Проверьте Cloudflare (WAF /tg/*, туннель), nginx и api."
          },
          "labels": {
            "service": "secret-santa",
            "severity": "warning"
          },
          "notification_settings": {
            "receiver": "Secret Santa Telegram"
          }
        }
      ]
    }
  ]
}
