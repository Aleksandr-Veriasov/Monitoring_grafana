    {
      "id": 3,
      "type": "stat",
      "title": "Доля 5xx за 1 ч",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "PBFA97CFB590B2093"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
