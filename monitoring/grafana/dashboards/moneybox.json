      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "PBFA97CFB590B2093"
          },
          "expr": "(sum(increase(moneybox_http_requests_total{job=\"moneybox\",status=~\"5..\"}[1h])) or vector(0)) / clamp_min(sum(increase(moneybox_http_requests_total{job=\"moneybox\",route!=\"/metrics\"}[1h])), 1)"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
