    {
      "id": 1,
      "type": "stat",
      "title": "Запросы за 24ч",
      "description": "Все строки access-лога по выбранным хостам",
      "datasource": {
        "type": "loki",
        "uid": "P8E80F9AEF21F6940"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 4,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "P8E80F9AEF21F6940"
          },
          "expr": "sum(count_over_time({container=~\"/?proxy-nginx\", stream=\"stdout\"} |= `\"status\"` | json host, status | __error__=\"\" | host=~\"$host\" [24h]))",
          "queryType": "instant"
